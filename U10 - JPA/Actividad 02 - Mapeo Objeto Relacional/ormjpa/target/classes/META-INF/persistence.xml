<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
             http://java.sun.com/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    
    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <class>entidades.EntityId</class>
        <class>entidades.AuditoriaApp</class>
        <class>entidades.Usuario</class>
        <class>entidades.Rubro</class>
        <class>entidades.Marca</class>
        <class>entidades.TipoMoneda</class>
        <class>entidades.CondicionIva</class>
        <class>entidades.Contacto</class>
        <class>entidades.Domicilio</class>
        <class>entidades.Cliente</class>
        <class>entidades.PuntoVenta</class>
        <class>entidades.Articulo</class>
        <class>entidades.ListaPrecio</class>
        <class>entidades.ListaPrecioArticulo</class>
        <class>entidades.FacturaVenta</class>
        <class>entidades.FacturaVentaDetalle</class>
        
        <properties>
            <!-- MySQL Configuration -->
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/facturacion?allowPublicKeyRetrieval=true&amp;useSSL=false&amp;serverTimezone=UTC"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            
            <!-- PostgreSQL Configuration (comentado)
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/facturacion"/>
            <property name="javax.persistence.jdbc.user" value="postgres"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            -->
            
            <!-- Hibernate Properties -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
